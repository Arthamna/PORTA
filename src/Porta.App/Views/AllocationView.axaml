<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Porta.ViewModels"
             x:Class="Porta.Views.AllocationView"
             x:DataType="vm:AllocationViewModel">
  <DockPanel Margin="28,24">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Classes="muted" Text="Atur target persentase ideal per kelas aset (total wajib 100%). Status: Overweight jika selisih > +5%, Underweight jika &lt; -5%." TextWrapping="Wrap" />
        <TextBlock Classes="muted">
          <Run Text="Net Worth saat ini:" />
          <Run Text="{Binding NetWorth, Converter={StaticResource Money}}" FontWeight="SemiBold" />
        </TextBlock>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="Muat Ulang" Command="{Binding RefreshCommand}" />
        <Button Content="Edit Kategori" Command="{Binding EditCategoryCommand}" IsEnabled="{Binding CanEdit}" />
        <Button Classes="danger" Content="Hapus Kategori" Command="{Binding DeleteCategoryCommand}" IsEnabled="{Binding CanEdit}" />
        <Button Content="+ Tambah Kategori" Command="{Binding AddCategoryCommand}" IsEnabled="{Binding CanEdit}" />
      </StackPanel>
    </Grid>

    <!-- Save bar -->
    <Border DockPanel.Dock="Bottom" Classes="card" Padding="16,12" Margin="0,16,0,0">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="primary" Content="Simpan Target Alokasi" Command="{Binding SaveTargetsCommand}" />
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="{Binding TotalTargetText}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
          <Border Classes="badge" Background="{StaticResource ProfitBrush}" IsVisible="{Binding IsTotalValid}">
            <TextBlock Text="Valid (100%)" />
          </Border>
          <Border Classes="badge" Background="{StaticResource LossBrush}" IsVisible="{Binding IsTotalInvalid}">
            <TextBlock Text="Total harus tepat 100% dan tiap target 0–100" />
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Classes="card" Padding="8">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="1.7*,80,1.3*,110,1.6*,100,2.6*" Margin="12,8">
          <TextBlock Grid.Column="0" Classes="label" Text="KELAS ASET" />
          <TextBlock Grid.Column="1" Classes="label" Text="RISIKO" />
          <TextBlock Grid.Column="2" Classes="label num" Text="NILAI PASAR" />
          <TextBlock Grid.Column="3" Classes="label num" Text="TARGET (%)" />
          <TextBlock Grid.Column="4" Classes="label" Text="AKTUAL" Margin="16,0,0,4" />
          <TextBlock Grid.Column="5" Classes="label num" Text="SELISIH" />
          <TextBlock Grid.Column="6" Classes="label" Text="REKOMENDASI" Margin="16,0,0,4" />
        </Grid>
        <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:AllocationRowViewModel">
              <Grid ColumnDefinitions="1.7*,80,1.3*,110,1.6*,100,2.6*" Margin="0,4">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding CategoryName}" FontWeight="SemiBold" />
                  <TextBlock Classes="muted" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding RiskLevel}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="num" VerticalAlignment="Center"
                           Text="{Binding MarketValue, Converter={StaticResource Money}}" />
                <TextBox Grid.Column="3" Text="{Binding TargetText}" HorizontalContentAlignment="Right" Margin="12,0,0,0"
                         IsEnabled="{Binding $parent[UserControl].((vm:AllocationViewModel)DataContext).CanEdit}" />
                <StackPanel Grid.Column="4" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="4">
                  <TextBlock Text="{Binding ActualPercentage, Converter={StaticResource Percent}}" FontWeight="SemiBold" />
                  <ProgressBar Value="{Binding ActualBar}" Maximum="100"
                               Foreground="{Binding Status, Converter={StaticResource RebalanceBrush}}" />
                </StackPanel>
                <TextBlock Grid.Column="5" Classes="num" VerticalAlignment="Center" FontWeight="SemiBold"
                           Text="{Binding Deviation, Converter={StaticResource Percent}, ConverterParameter=signed}"
                           Foreground="{Binding Status, Converter={StaticResource RebalanceBrush}}" />
                <Border Grid.Column="6" Classes="badge" Margin="16,0,0,0"
                        Background="{Binding Status, Converter={StaticResource RebalanceBrush}}">
                  <TextBlock Text="{Binding StatusLabel}" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </DockPanel>
</UserControl>
